[Unit]
Description=FeiYu local control panel
After=docker.service
Wants=docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=feiyu
Group=feiyu
WorkingDirectory=/opt/feiyu/source
Environment=DAFEIYU_DATA_DIR=/var/lib/feiyu/data
Environment=DAFEIYU_QZONE_PUBLISH=0
Environment=DAFEIYU_MEMORY_BRIDGE=/opt/feiyu/runtime/memory-bridge.mjs
Environment=DAFEIYU_SHARED_MEMORY_DIR=/var/lib/feiyu/shared-memory
Environment=DAFEIYU_LOCAL_ACCESS_DIR=/var/lib/feiyu/private
Environment=DAFEIYU_BRIDGE_CONFIG_DIR=/var/lib/feiyu/qq-runtime/config
Environment=DAFEIYU_MODEL_BASE_URL=https://api.deepseek.com
EnvironmentFile=-/var/lib/feiyu/private/deployment.env
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/mnt/wslg/runtime-dir
ExecStart=/opt/feiyu/source/dist/dafeiyu-linux/dafeiyu
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=20
UMask=0077
StandardOutput=truncate:/var/lib/feiyu/logs/panel.log
StandardError=inherit
